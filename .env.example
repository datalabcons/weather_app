# Copy this file to .env and fill in your values

# Get a free key at https://www.visualcrossing.com/sign-up
WEATHER_API_KEY=your-visual-crossing-api-key

# Redis connection string. Leave empty to use the in-memory cache.
# Local Redis:   redis://localhost:6379
# Upstash:       rediss://default:<password>@<host>:6379
REDIS_URL=

PORT=3000

# How long weather results stay cached, in seconds (3600 = 1 hour)
CACHE_TTL_SECONDS=3600

# Rate limit: max requests per IP per window
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MINUTES=15
